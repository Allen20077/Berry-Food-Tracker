{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "frontend": {
            "root": "www/",
            "framework": null
        },
        "backend": {
            "root": "Backend/",
            "entrypoint": "main:app"
        }
    },
    "rewrites": [{
            "source": "/api/(.*)",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "frontend"
            }
        }
    ]
}